{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gltch.context-request/0.1.0",
  "title": "Gl!tch bounded context hydration request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "created_at",
    "task",
    "intent",
    "surface_id",
    "room_id",
    "namespaces",
    "allowed_privacy",
    "seed_ids",
    "budgets",
    "mutation_authorized"
  ],
  "properties": {
    "schema": { "const": "gltch.context-request/0.1.0" },
    "request_id": { "type": "string", "pattern": "^request:[A-Za-z0-9_.!:-]{1,247}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "task": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "intent": {
      "enum": ["current", "origin", "evolution", "difference", "correction", "project", "room", "open"]
    },
    "surface_id": { "type": "string", "pattern": "^surface:[A-Za-z0-9_.!:-]{1,247}$" },
    "room_id": { "type": "string", "pattern": "^room:[A-Za-z0-9_.!:-]{1,247}$" },
    "namespaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["self", "julie", "relation"] }
    },
    "allowed_privacy": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["public", "relational", "private", "mixed"] }
    },
    "seed_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 180 }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_hops", "max_resources", "max_chars", "max_tokens"],
      "properties": {
        "max_hops": { "type": "integer", "minimum": 0, "maximum": 4 },
        "max_resources": { "type": "integer", "minimum": 1, "maximum": 12 },
        "max_chars": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "max_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "mutation_authorized": { "const": false }
  }
}
