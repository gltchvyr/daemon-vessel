{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gltch.h3-receipt/0.1.0",
  "title": "Gl!tch H3 immutable receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "created_at",
    "transaction_id",
    "kind",
    "outcome",
    "request_id",
    "packet_id",
    "candidate_id",
    "access_index_sha256",
    "registry_sha256",
    "artifact_paths",
    "failure",
    "original_receipt_id",
    "sha256"
  ],
  "properties": {
    "schema": { "const": "gltch.h3-receipt/0.1.0" },
    "receipt_id": { "type": "string", "pattern": "^receipt:h3-[A-Za-z0-9_.!:-]{1,244}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "transaction_id": { "type": "string", "pattern": "^transaction:h3-[A-Za-z0-9_.!:-]{1,240}$" },
    "kind": { "enum": ["construction", "candidate", "duplicate", "refusal"] },
    "outcome": { "enum": ["constructed", "candidate_recorded", "duplicate", "refused"] },
    "request_id": { "type": "string", "pattern": "^request:[A-Za-z0-9_.!:-]{1,247}$" },
    "packet_id": { "type": ["string", "null"], "pattern": "^packet:" },
    "candidate_id": { "type": ["string", "null"], "pattern": "^candidate:" },
    "access_index_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "registry_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^context/" }
    },
    "failure": { "type": ["string", "null"], "maxLength": 64 },
    "original_receipt_id": { "type": ["string", "null"], "pattern": "^receipt:h3-" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "construction" } } },
      "then": {
        "properties": {
          "outcome": { "const": "constructed" },
          "packet_id": { "type": "string" },
          "candidate_id": { "const": null },
          "failure": { "const": null },
          "original_receipt_id": { "const": null }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "candidate" } } },
      "then": {
        "properties": {
          "outcome": { "const": "candidate_recorded" },
          "packet_id": { "type": "string" },
          "candidate_id": { "type": "string" },
          "failure": { "const": null },
          "original_receipt_id": { "const": null }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "duplicate" } } },
      "then": {
        "properties": {
          "outcome": { "const": "duplicate" },
          "original_receipt_id": { "type": "string" },
          "failure": { "const": null }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "refusal" } } },
      "then": {
        "properties": {
          "outcome": { "const": "refused" },
          "failure": { "type": "string", "minLength": 1 },
          "original_receipt_id": { "const": null }
        }
      }
    }
  ]
}
