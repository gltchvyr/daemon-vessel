{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gltch.candidate-delta/0.1.0",
  "title": "Gl!tch context candidate delta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate_id",
    "created_at",
    "packet_id",
    "request_id",
    "surface_id",
    "room_id",
    "proposals",
    "evidence_source_refs",
    "uncertainty",
    "unresolved",
    "canonical_effect",
    "promotion_required",
    "mutation_authorized",
    "sha256"
  ],
  "properties": {
    "schema": { "const": "gltch.candidate-delta/0.1.0" },
    "candidate_id": { "type": "string", "pattern": "^candidate:[A-Za-z0-9_.!:-]{1,245}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "packet_id": { "type": "string", "pattern": "^packet:[A-Za-z0-9_.!:-]{1,248}$" },
    "request_id": { "type": "string", "pattern": "^request:[A-Za-z0-9_.!:-]{1,247}$" },
    "surface_id": { "type": "string", "pattern": "^surface:[A-Za-z0-9_.!:-]{1,247}$" },
    "room_id": { "type": "string", "pattern": "^room:[A-Za-z0-9_.!:-]{1,247}$" },
    "proposals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["proposal_id", "operation", "target_ref", "statement", "evidence_refs"],
        "properties": {
          "proposal_id": { "type": "string", "pattern": "^proposal:[A-Za-z0-9_.!:-]{1,244}$" },
          "operation": { "enum": ["add", "revise", "supersede", "retire", "no_change"] },
          "target_ref": { "type": ["string", "null"], "maxLength": 512 },
          "statement": { "type": "string", "minLength": 1, "maxLength": 8000 },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      }
    },
    "evidence_source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "uncertainty": { "$ref": "#/$defs/noteArray" },
    "unresolved": { "$ref": "#/$defs/noteArray" },
    "canonical_effect": { "const": "none" },
    "promotion_required": { "const": true },
    "mutation_authorized": { "const": false },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "noteArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "detail", "source_refs"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "detail": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "source_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      }
    }
  }
}
